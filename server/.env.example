NODE_ENV=development
HOST=127.0.0.1
PORT=4000

DATABASE_URL=postgresql://meal_user:YOUR_DATABASE_PASSWORD@localhost:5432/meal

CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=./uploads

ACCESS_TOKEN_SECRET=REPLACE_WITH_A_GENERATED_SECRET
REFRESH_TOKEN_SECRET=REPLACE_WITH_ANOTHER_GENERATED_SECRET

# Exactly 64 hexadecimal characters.
FILE_KEY=REPLACE_WITH_A_GENERATED_KEY

# Separate key used for encrypted database backups.
BACKUP_KEY=REPLACE_WITH_ANOTHER_GENERATED_KEY

# Change this if your PostgreSQL tools are installed elsewhere.
PG_BIN="C:/Program Files/PostgreSQL/17/bin"